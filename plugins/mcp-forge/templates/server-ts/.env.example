# {{TITLE}} MCP server configuration. Copy to .env (never commit .env).
# Auth comes ONLY from environment variables; never from tool arguments.
{{ENV_PREFIX}}_BASE_URL=https://api.example.com/v1
{{ENV_PREFIX}}_API_KEY=replace-me
{{ENV_PREFIX}}_TIMEOUT_MS=10000
# Set to "true" to disable all write tools (propose_*/confirm_*).
{{ENV_PREFIX}}_READ_ONLY=false
